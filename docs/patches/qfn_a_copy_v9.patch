+def _qfn_a_scope():
+    import os
+    v = os.environ.get("QFN_A_LAYER")
+    if v is None:
+        return -1
+    if str(v).lower() == "all":
+        return -2
+    try:
+        return int(v)
+    except Exception:
+        return -1
+
+
+def _qfn_layer_index(layer):
+    import re
+    for attr in ("layer_name", "prefix", "name"):
+        m = re.search(r"layers?\.(\d+)", str(getattr(layer, attr, "") or ""))
+        if m:
+            return int(m.group(1))
+    return -1
+
+
+def _qfn_copy_gpu0(layer):
+    scope = _qfn_a_scope()
+    idx = _qfn_layer_index(layer)
+    if scope < -1:
+        ok = idx >= 0
+    elif scope >= 0:
+        ok = idx == scope
+    else:
+        return
+    if not ok:
+        return
+    import torch
+    if torch.cuda.device_count() < 2:
+        print(f"[qfn-a] sidecar not visible (devices={torch.cuda.device_count()})", flush=True)
+        return
+    if torch.cuda.current_device() != 0:
+        return
+    dev = torch.device("cuda", torch.cuda.device_count() - 1)
+    names = ("w13_weight", "w13_weight_scale", "w13_weight_scale_2",
+             "w2_weight", "w2_weight_scale", "w2_weight_scale_2")
+    E = layer.w13_weight.shape[0]
+    mask = (torch.arange(E, device=layer.w13_weight.device) % 5) < 2
+    d = {}
+    for n in names:
+        t = getattr(layer, n, None)
+        if t is None:
+            continue
+        d[n] = t[mask].detach().to(dev).contiguous()
+    idxmap = torch.full((E,), -1, dtype=torch.long)
+    idxmap[mask] = torch.arange(int(mask.sum()), dtype=torch.long)
+    d["_idx"] = idxmap
+    layer._qfn_gpu0 = d
+    gb = sum(x.numel() * x.element_size() for x in d.values()) / 1e9
+    print(f"[qfn-a] layer={idx} sidecar {gb:.3f} GB ({int(mask.sum())}/{E} experts)", flush=True)
+
