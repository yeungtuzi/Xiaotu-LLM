+# TMA (Tensor Memory Accelerator) first appears on MP31.  Older MUSA targets
+# such as MP22 (MTT S4000) reject the explicit ``T.tma_copy`` lowering, so the
+# state staging has to go through plain shared-memory copies there.
+_TMA_MIN_ARCH = (3, 1)
+_TMA_ENV_OVERRIDE = "MATE_GDN_DECODE_TMA"
+_FALSE_VALUES = ("0", "false", "off", "no")
+_TRUE_VALUES = ("1", "true", "on", "yes")
+
+
+@functools.lru_cache(maxsize=8)
+def _device_arch(device_index: int) -> tuple[int, int] | None:
+    try:
+        import torch_musa
+
+        props = torch_musa.get_device_properties(device_index)
+    except Exception:
+        return None
+    return (int(props.major), int(props.minor))
+
+
+def target_supports_tma() -> bool:
+    """Whether the active MUSA target exposes TMA copy/store instructions.
+
+    ``MATE_GDN_DECODE_TMA`` can force the decision (``1``/``0``); it exists so
+    the non-TMA path can also be exercised on TMA-capable hardware.
+    """
+    override = os.environ.get(_TMA_ENV_OVERRIDE)
+    if override is not None:
+        value = override.strip().lower()
+        if value in _FALSE_VALUES:
+            return False
+        if value in _TRUE_VALUES:
+            return True
+        raise ValueError(
+            f"{_TMA_ENV_OVERRIDE} must be one of {_TRUE_VALUES + _FALSE_VALUES}, "
+            f"got {override!r}."
+        )
+
+    try:
+        device_index = torch.musa.current_device()
+    except Exception:
+        # Unknown target: keep the historical TMA path.
+        return True
+    arch = _device_arch(device_index)
+    if arch is None:
+        return True
+    return arch >= _TMA_MIN_ARCH
+
 
