From: XTU MUSA bring-up
Subject: [PATCH] qwen4_exp/amd: disable CUDA PDL/GDC on MUSA

Candidate patch against vLLM v0.32.0; NOT hardware-validated.
MUSA Triton has no tl.extra.cuda.gdc_*; force launch_pdl=False.

diff --git a/vllm/models/qwen4_exp/amd/ops/hc.py b/vllm/models/qwen4_exp/amd/ops/hc.py
index 1faf89b..70d84d9 100644
--- a/vllm/models/qwen4_exp/amd/ops/hc.py
+++ b/vllm/models/qwen4_exp/amd/ops/hc.py
@@ -9,6 +9,13 @@ from vllm.triton_utils import tl, triton
 from vllm.utils.torch_utils import direct_register_custom_op
 
 
+def _qwen4_exp_launch_pdl() -> bool:
+    """MUSA Triton has no CUDA GDC/PDL primitives."""
+    return current_platform.is_arch_support_pdl() and not getattr(
+        current_platform, "is_musa", lambda: False
+    )()
+
+
 @triton.jit
 def _grouped_gemma_rmsnorm_kernel(
     x_ptr,
@@ -73,7 +80,7 @@ def _grouped_gemma_rmsnorm(
         num_groups,
         W_SHARED=weight.numel() == group_dim,
         EPS=eps,
-        launch_pdl=current_platform.is_arch_support_pdl(),
+        launch_pdl=_qwen4_exp_launch_pdl(),
     )
     return y
 
@@ -117,7 +124,7 @@ def _hc_silu(x: torch.Tensor, hc_count: int) -> torch.Tensor:
         output.stride(0),
         DIM=DIM,
         HC=hc_count,
-        launch_pdl=current_platform.is_arch_support_pdl(),
+        launch_pdl=_qwen4_exp_launch_pdl(),
     )
     return output
 
@@ -180,7 +187,7 @@ def _hc_gate_mix(x: torch.Tensor, gate: torch.Tensor, hc_count: int) -> torch.Te
         DIM,
         hc_count,
         BLOCK_SIZE,
-        launch_pdl=current_platform.is_arch_support_pdl(),
+        launch_pdl=_qwen4_exp_launch_pdl(),
     )
     return out
 
@@ -258,7 +265,7 @@ def _hc_combine(
         hc_dim,
         hc_count,
         BLOCK_SIZE,
-        launch_pdl=current_platform.is_arch_support_pdl(),
+        launch_pdl=_qwen4_exp_launch_pdl(),
     )
     return out
 
@@ -370,7 +377,7 @@ def _hc_combine_norm(
         W_SHARED=norm_weight.numel() == hc_dim,
         EPS=eps,
         BLOCK_SIZE=BLOCK_SIZE,
-        launch_pdl=current_platform.is_arch_support_pdl(),
+        launch_pdl=_qwen4_exp_launch_pdl(),
     )
     return out, y
 
